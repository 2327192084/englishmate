{
  "name": "typeflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "TypeFlow · 打字即学习的开源英语学习应用（桌面版）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "dicts": "node scripts/build-dicts.mjs",
    "verify": "node scripts/verify-data.mjs",
    "electron:dev": "vite",
    "electron:run": "electron electron/main.cjs",
    "smoke:desktop": "electron electron/smoke.cjs --user-data-dir=.tmp/udd",
    "dist:win": "npm run build:desktop && electron-builder --win --config electron-builder.config.cjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dicts:rich": "node scripts/build-rich-dicts.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.3.0",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1",
    "postcss": "^8.4.49",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "main": "electron/main.cjs"
}
